# SQLAlchemy database URL.
# Example for local development:
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_mock_interview
DATABASE_URL=

# Secret used to sign JWT access tokens. Generate a strong random value.
JWT_SECRET_KEY=

# Google Gemini API key used by interview and practice AI features.
GOOGLE_API_KEY=

# Optional: override the Gemini model name.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional comma-separated frontend origins.
# CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=
